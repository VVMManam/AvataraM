# Copy this file to ".env" and fill in your keys.

# Anthropic (Claude) API key - https://console.anthropic.com
ANTHROPIC_API_KEY=

# Fast, low-cost model. Change if you want a smarter (more expensive) one.
CLAUDE_MODEL=claude-haiku-5-5

# Azure AI Speech (free F0 tier) - Azure Portal > Create "Speech service"
AZURE_SPEECH_KEY=

AZURE_SPEECH_REGION=eastus
